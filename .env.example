# ==============================================================================
# OVERLEAF-STRATUM — Environment Configuration Template
# Stratum Consumer Pattern
# ==============================================================================

# Timezone identifier
TZ=America/Bogota

# --- Tenant Multi-Tenancy Identity ---
# Unique slug for this tenant/organization (e.g. acme, lab, team1)
TENANT_ID=tenant-a

# --- Container Image & Identity ---
# WARNING: Do NOT use :latest! Version 6.3.0+ contains a Node 22 bug with mongodb-legacy.
OVERLEAF_IMAGE=sharelatex/sharelatex:6.2.2
# OVERLEAF_CONTAINER_NAME=overleaf-tenant-a-app  # (Defaults to: overleaf-${TENANT_ID}-app)
# OVERLEAF_VOLUME_NAME=overleaf_tenant-a_data    # (Defaults to: overleaf_${TENANT_ID}_data)

# --- Shared Stratum DMZ Network ---
STRATUM_DMZ_NETWORK=stratum_dmz

# --- Stratum Transversal Database Boundary Proxy ---
STRATUM_DB_HOST=stratum-database-nginx
STRATUM_REDIS_PORT=6379

# --- Database Credentials (Provisioned via stratum-cli mongo provision) ---
# IMPORTANT: Passwords must be URL-safe (Alphanumeric). If using symbols like %, @, +,
# they MUST be URL-encoded (e.g. %25, %40, %2B), otherwise the connection URL will crash.
MONGO_APP_USER=tenant-a_overleaf_app
MONGO_APP_PASSWORD=generate_a_secure_mongo_password_here
MONGO_DB_NAME=tenant-a_overleaf
MONGO_AUTH_SOURCE=admin
# Required query params for single-node replica set behind Stratum Proxy
MONGO_EXTRA_PARAMS=&replicaSet=rs0&directConnection=true

REDIS_PASSWORD=generate_a_secure_redis_password_here

# --- Overleaf Application Identity & Endpoints ---
OVERLEAF_APP_NAME="Overleaf Community Edition"
OVERLEAF_SITE_URL=https://latex.example.com
OVERLEAF_NAV_TITLE="LaTeX Studio"

# --- Security Secrets (Generate using: openssl rand -base64 32) ---
# Persistent session encryption secret (prevents users being logged out on restart)
OVERLEAF_SESSION_SECRET=generate_a_random_32_byte_base64_session_secret
# User invitation token cryptographic salt
OVERLEAF_INVITE_TOKEN_SECRET=generate_a_random_32_byte_base64_invite_secret

# --- Feature Flags & Security Safeguards ---
# Disables open public registrations if you only want admin-invited users
OVERLEAF_ALLOW_PUBLIC_ACCESS=false
EMAIL_CONFIRMATION_DISABLED=true
ENABLE_CONVERSIONS=true

# --- Resource Quotas (Calibrated for 2 vCPU / 4GB RAM VPS) ---
CPU_LIMIT=1.5
MEM_LIMIT=2.5G
MEM_RESERVATION=768M
NODE_OPTIONS=--max-old-space-size=1536
